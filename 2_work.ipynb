# Cell 1: Load data on a copy for cleaning
import pandas as pd
import numpy as np

df_original = pd.read_csv('teaching_prices_messy.csv')
df = df_original.copy() # Work on a copy

print("--- BEFORE CLEANING ---")
print("Shape:", df.shape)
print("Missing counts:\n", df.isnull().sum())
display(df.describe())

# Cell 2: Cleaning Steps (Evaluated Line-by-Line)
# Strip whitespace from item names
df['item_name'] = df['item_name'].str.strip()

# Convert date column to datetime
df['date'] = pd.to_datetime(df['date'], errors='coerce')

# Drop rows where price is missing
df = df.dropna(subset=['price'])

# Filter out extreme outliers (e.g., negative prices)
df = df[df['price'] > 0]

print("\n--- AFTER CLEANING ---")
print("Shape:", df.shape)
print("Missing counts:\n", df.isnull().sum())
display(df.describe())
